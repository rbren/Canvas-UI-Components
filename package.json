{
  "name": "canvas-ui-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @openhands/canvas-core && npm run build -w @openhands/canvas-react && npm run build -w @openhands/canvas-ui",
    "build:example": "npm run build && npm run build -w @openhands/canvas-example",
    "dev": "npm run build && npm run dev -w @openhands/canvas-example",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packages": "node scripts/check-packages.mjs",
    "check": "npm run typecheck && npm test && npm run build:example && npm run test:packages",
    "format": "prettier --write packages examples scripts *.json *.ts",
    "format:check": "prettier --check packages examples scripts *.json *.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "ws": "8.22.0"
  }
}
